# 로컬 개발용 예시예요. 복사해서 .env로 만들고 값을 채워 주세요. (.env는 커밋되지 않아요)

# PostgreSQL — 로컬은 docker compose, 운영은 Neon(Vercel이 자동 등록)
DATABASE_URL=postgresql://clickchef:clickchef@localhost:5432/clickchef

# Gemini (Google AI Studio 무료 키, 결제 미연결)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 1이면 Gemini 대신 정해진 재료 목록을 돌려줘요 (키 없이 흐름 테스트)
VISION_MOCK=1

# 사진 인식 IP당 하루 제한
DETECT_DAILY_LIMIT=30

# 데이터 파이프라인 (로컬에서 한 번만 실행)
MFDS_API_KEY=sample
EXAONE_API_KEY=
EXAONE_BASE_URL=   # docs.exaone.ai에서 확인한 API 주소
